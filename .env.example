# Supabase — Project Settings > API no dashboard do projeto
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-anon-public-key

# TMDB — o "Read Access Token" (v4), não a API Key (v3).
# Em https://www.themoviedb.org/settings/api, seção "API Read Access Token".
# Vai como Bearer no header; fica só no servidor, nunca é exposto ao browser.
NUXT_TMDB_API_KEY=

# Spotify (módulo Músicas) — em https://developer.spotify.com/dashboard,
# "Create app". As duas ficam só no servidor, atrás de /api/spotify/*.
#
# O app deve FICAR em development mode: nesse modo ele atende só as contas
# cadastradas à mão em "User Management" (ordem de 25), que é exatamente o que
# um app de casal precisa. Pedir extension request exige métricas de produto
# comercial. Para a busca do catálogo isso nem pesa — ela usa o token de
# aplicativo (client credentials) e não depende de conta nenhuma conectada.
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=

# Google Maps (módulo Viagens) — DUAS chaves do mesmo projeto do Google Cloud,
# porque elas têm naturezas opostas. Ver a seção 5 do README.
#
# Places API (New): fica só no servidor, atrás de /api/lugares/*. Sem restrição
# de origem (chamada de servidor não tem referrer), então o que a protege é não
# vazar e o limite de cota diária.
NUXT_GOOGLE_PLACES_API_KEY=
#
# Maps Embed API: vai no src do iframe, logo é PÚBLICA — não há como esconder.
# O que a protege é a restrição por HTTP referrer no Google Cloud (localhost + o
# domínio do Vercel) e ela estar limitada à Maps Embed API e a nada mais.
NUXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
