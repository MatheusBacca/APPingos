{
  "manifest_version": 3,
  "name": "APPingos",
  "version": "0.1.0",
  "description": "Captura o produto da página e registra como interesse no APPingos.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Registrar interesse no APPingos"
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.supabase.co/*"]
}
